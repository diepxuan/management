[Unit]
Description=DiepXuan personal service
After=network-online.target network.target

# --- Restart policy ---
# StartLimit* phải nằm trong [Unit]; đặt trong [Service] bị systemd bỏ qua
# (log báo: Unknown key 'StartLimitIntervalSec' in section [Service]).
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
ExecStart=/usr/bin/ductn service

# Báo cho Python biết đang chạy dưới systemd để chỉ ghi stdout (journal),
# tránh mở thêm RotatingFileHandler cùng file log => nhân đôi dòng log.
Environment=RUNNING_UNDER_SYSTEMD=1

# --- Logging ---
# KHÔNG redirect stdout vào /var/log/ductnd/ductnd.log ở đây: Python đã tự
# ghi file đó qua RotatingFileHandler (utils/__init__.py). Trước 5.8.6 cả
# hai cùng ghi một file nên mỗi dòng log bị nhân đôi. Để systemd dùng
# journal mặc định; file log có rotation do Python quản lý.

# --- Process control ---
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=1min

# --- Restart policy ---
Restart=on-failure
RestartSec=10s

# --- Limits ---
LimitNPROC=infinity
LimitNOFILE=infinity
TasksMax=infinity
UMask=007

[Install]
WantedBy=multi-user.target
Alias=ductnd.service
